# Copiá este archivo como .env y completá cada valor
# NUNCA subas el archivo .env a GitHub — está en .gitignore

PORT=3000
HOST=127.0.0.1

# Google OAuth2 — obtenelo en console.cloud.google.com > Credenciales
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# YouTube Data API v3 — habilitar en console.cloud.google.com > APIs
YOUTUBE_API_KEY=

# ID del canal de YouTube de Galeria (empieza con UC...)
YOUTUBE_CHANNEL_ID=

# Refresh token del canal maestro — se genera visitando /api/auth/google/master desde localhost
YOUTUBE_MASTER_REFRESH_TOKEN=

# Desarrollo: poner en true para que los endpoints de YouTube devuelvan datos estáticos
# y no consuman cuota de la API mientras se trabaja en el frontend
USE_MOCK_DATA=false
